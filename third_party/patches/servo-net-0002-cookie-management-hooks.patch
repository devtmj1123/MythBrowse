+#[cfg(test)]
+mod mythbrowse_tests {
+    use super::*;
+
+    fn add(jar: &mut CookieStorage, url: &str, set_cookie: &str) {
+        let url = ServoUrl::parse(url).unwrap();
+        let c = ServoCookie::from_cookie_string(set_cookie, &url, CookieSource::HTTP).unwrap();
+        jar.push(c, &url, CookieSource::HTTP);
+    }
+
+    #[test]
+    fn redacted_listing_and_exact_delete() {
+        let mut jar = CookieStorage::new(150);
+        add(&mut jar, "https://www.example.com/a/b", "sid=secret; HttpOnly; Secure");
+        add(&mut jar, "https://example.com/", "pref=dark; Domain=example.com; Path=/");
+        add(&mut jar, "https://mail.example.com/", "x=1; Path=/inbox");
+        add(&mut jar, "https://other.org/", "o=1");
+
+        let all = jar.site_cookies_redacted("example.com");
+        assert_eq!(all.len(), 3);
+        assert!(all.iter().all(|c| c.value().starts_with("mbmeta.")));
+        assert!(!all.iter().any(|c| c.value().contains("secret")));
+        let sid = all.iter().find(|c| c.name() == "sid").unwrap();
+        assert_eq!(sid.value(), "mbmeta.9.1");
+        assert_eq!(sid.domain(), Some("www.example.com"));
+        assert_eq!(sid.path(), Some("/a"));
+        assert_eq!(
+            all.iter().find(|c| c.name() == "pref").unwrap().value(),
+            "mbmeta.8.0"
+        );
+
+        // Wrong path or domain removes nothing; the exact triple removes one, HttpOnly too.
+        assert!(!jar.delete_cookie_exact("www.example.com", "/", "sid"));
+        assert!(!jar.delete_cookie_exact("example.com", "/a", "sid"));
+        assert!(jar.delete_cookie_exact("www.example.com", "/a", "sid"));
+        assert!(jar.delete_cookie_exact(".example.com", "/", "pref"));
+        let left = jar.site_cookies_redacted("example.com");
+        assert_eq!(left.len(), 1);
+        assert_eq!(left[0].name(), "x");
+        assert_eq!(jar.site_cookies_redacted("other.org").len(), 1);
+        assert!(jar.delete_cookie_exact("mail.example.com", "/inbox", "x"));
+        assert!(jar.site_cookies_redacted("example.com").is_empty());
+    }
+
+    #[test]
+    fn blocked_site_stores_and_sends_nothing() {
+        let mut jar = CookieStorage::new(150);
+        add(&mut jar, "https://tracker.test/", "keep=1");
+        crate::mythbrowse_cookies::set_blocked("tracker.test", true);
+        add(&mut jar, "https://ads.tracker.test/", "t=1");
+        let url = ServoUrl::parse("https://tracker.test/").unwrap();
+        assert_eq!(jar.cookies_for_url(&url, CookieSource::HTTP), None);
+        crate::mythbrowse_cookies::set_blocked("tracker.test", false);
+        // Stored before the block, not after it.
+        assert_eq!(
+            jar.cookies_for_url(&url, CookieSource::HTTP).as_deref(),
+            Some("keep=1")
+        );
+    }
+}
