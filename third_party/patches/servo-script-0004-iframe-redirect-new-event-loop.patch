+        // MythBrowse (servo-script 0004): the constellation picked this pipeline's event loop
+        // from the URL the navigation started at. When an iframe navigation is redirected back
+        // to the site of the document that started it (an OAuth / SSO hop: parent A, frame
+        // B -> A), following the redirect here would create that document in B's event loop:
+        // its same-origin parent then gets a cross-origin WindowProxy (SecurityError) and
+        // BroadcastChannel messages between them are lost. Hand the redirect target back to
+        // the constellation as a replacing navigation instead, so the new pipeline is created
+        // in the event loop of its own site; the constellation discards this pending pipeline
+        // (servo-constellation 0001). At most one hop per chain: the new load's URL is
+        // same-site with its initiator.
+        if let Some(location) = Self::redirect_needs_new_event_loop(incomplete_load, metadata) {
+            let mut load_data = incomplete_load.load_data.clone();
+            load_data.url = location;
+            load_data.referrer = metadata
+                .referrer
+                .clone()
+                .map(Referrer::ReferrerUrl)
+                .unwrap_or(Referrer::NoReferrer);
+            load_data.referrer_policy = metadata.referrer_policy;
+            let target_snapshot_params = incomplete_load.target_snapshot_params;
+            let webview_id = incomplete_load.webview_id;
+            incomplete_loads.retain(|load| load.pipeline_id != id);
+            drop(incomplete_loads);
+            self.incomplete_parser_contexts
+                .0
+                .borrow_mut()
+                .retain(|(pipeline_id, _)| *pipeline_id != id);
+            let _ = self.senders.pipeline_to_constellation_sender.send((
+                webview_id,
+                id,
+                ScriptToConstellationMessage::LoadUrl(
+                    load_data,
+                    NavigationHistoryBehavior::Replace,
+                    target_snapshot_params,
+                ),
+            ));
+            return;
+        }
+
         // Update the `url_list` of the incomplete load to track all redirects. This will be reflected
         // in the new `RequestBuilder` as well.
         incomplete_load.url_list.push(metadata.final_url.clone());
