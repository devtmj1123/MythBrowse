+    /// MythBrowse (servo-script 0004): the redirect target of an `<iframe>` navigation when
+    /// following it in this pipeline would put the document in the wrong event loop: a GET
+    /// load, not origin-sandboxed, started by a script document (the parent, or the frame
+    /// itself) whose site is the target's site, while the URL this pipeline was created for
+    /// (which chose its event loop) is another site. Sites are compared as the constellation
+    /// keys event loops: registered domain, or the IP address.
+    fn redirect_needs_new_event_loop(
+        load: &InProgressLoad,
+        metadata: &Metadata,
+    ) -> Option<ServoUrl> {
+        use net_traits::pub_domains::registered_domain_name;
+        if load.parent_info.is_none() ||
+            load.load_data.method != http::Method::GET ||
+            load.load_data.creation_sandboxing_flag_set.contains(
+                content_security_policy::sandboxing_directive::SandboxingFlagSet::SANDBOXED_ORIGIN_BROWSING_CONTEXT_FLAG,
+            )
+        {
+            return None;
+        }
+        let LoadOrigin::Script(initiator) = &load.load_data.load_origin else {
+            return None;
+        };
+        let Some(Ok(location)) = &metadata.location_url else {
+            return None;
+        };
+        let target_site = registered_domain_name(location)?;
+        let initiator_site = match initiator.immutable() {
+            ImmutableOrigin::Tuple(_, url::Host::Domain(domain), _) => url::Host::Domain(String::from(
+                net_traits::pub_domains::reg_suffix(domain),
+            )),
+            ImmutableOrigin::Tuple(_, ip, _) => ip.clone(),
+            ImmutableOrigin::Opaque(_) => return None,
+        };
+        if target_site != initiator_site ||
+            registered_domain_name(&load.load_data.url).as_ref() == Some(&target_site)
+        {
+            return None;
+        }
+        Some(location.clone())
+    }
