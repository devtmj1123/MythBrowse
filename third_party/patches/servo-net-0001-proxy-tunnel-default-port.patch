+#[cfg(test)]
+mod default_port_tests {
+    use super::*;
+
+    fn d(s: &str) -> Destination {
+        s.parse().unwrap()
+    }
+
+    #[test]
+    fn plain_http_gets_port_80() {
+        assert_eq!(with_default_port(d("http://example.com/")).port_u16(), Some(80));
+        assert_eq!(with_default_port(d("http://example.com")).port_u16(), Some(80));
+        assert_eq!(with_default_port(d("ws://example.com/x")).port_u16(), Some(80));
+    }
+
+    #[test]
+    fn https_gets_port_443() {
+        assert_eq!(with_default_port(d("https://example.com/")).port_u16(), Some(443));
+        assert_eq!(with_default_port(d("wss://example.com/")).port_u16(), Some(443));
+    }
+
+    #[test]
+    fn explicit_port_and_host_are_kept() {
+        let x = with_default_port(d("http://example.com:8080/a?b"));
+        assert_eq!(x.port_u16(), Some(8080));
+        assert_eq!(x.host(), Some("example.com"));
+        assert_eq!(with_default_port(d("http://[::1]/")).host(), Some("[::1]"));
+        assert_eq!(with_default_port(d("http://[::1]/")).port_u16(), Some(80));
+    }
+}
