+/// `dest` with its scheme's default port made explicit (80 for http/ws, 443 for https/wss),
+/// so a proxy `CONNECT` goes to the right port. Destinations that already name a port, have no
+/// authority, or cannot be rebuilt are returned unchanged.
+fn with_default_port(dest: Destination) -> Destination {
+    if dest.port().is_some() {
+        return dest;
+    }
+    let port = match dest.scheme_str() {
+        Some("http") | Some("ws") => 80,
+        Some("https") | Some("wss") => 443,
+        _ => return dest,
+    };
+    let Some(host) = dest.host() else {
+        return dest;
+    };
+    let authority = if host.contains(':') && !host.starts_with('[') {
+        format!("[{host}]:{port}")
+    } else {
+        format!("{host}:{port}")
+    };
+    let mut parts = dest.clone().into_parts();
+    match Authority::from_maybe_shared(authority) {
+        Ok(authority) => parts.authority = Some(authority),
+        Err(_) => return dest,
+    }
+    if parts.path_and_query.is_none() {
+        parts.path_and_query = Some(http::uri::PathAndQuery::from_static("/"));
+    }
+    Destination::from_parts(parts).unwrap_or(dest)
+}
